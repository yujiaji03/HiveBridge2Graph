 , a.label_code_all      
 , a.driver              
 , a.handler_name        
 , a.fee                 
 
 
 ,case when a.station_no in ('G0055430050240','G0055430050250','G0055430050260') then '4303039'
when a.station_no in ('G0055430050220','G0055430050230') then '4303042'
when a.station_no in('G0055430020100','G0055430020110','G0055430020120','G0055430020130','G0055430020140') then '4303044'
when a.station_no in( 'G0055430020090') then '4303045'  else  a.center_no end as center_no  
 , case when a.station_no in ('G0055430050240','G0055430050250','G0055430050260') then '永州分公司'
when a.station_no in ('G0055430050220','G0055430050230') then '邵阳分公司'
when a.station_no in('G0055430020100','G0055430020110','G0055430020120','G0055430020130','G0055430020140') then '益阳分公司'
when a.station_no in( 'G0055430020090') then '常德分公司' else a.center_name end as center_name  
 , a.station_no          
 
 , a.station_name  as station_name        
 , a.flee_time_beg       
 , a.reward              
 , a.reward_person_name  
 , a.flee_time_end       
 , a.complete_flag       
 , a.create_time         
 , a.complete_time       
 , a.payment_id 
 , substr(current_timestamp(),1,19) as in_time
 ,'' as statis_date
from ngods.t_archives a  
